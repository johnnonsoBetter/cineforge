# Copy to .env and fill in. Leave MOCK_MODE=true to run with no keys.
MOCK_MODE=true

# Backblaze B2 (storage) — required for real runs.
# IMPORTANT: the bucket MUST be public. Generated media URLs are credential-free but the
# canvas renders them straight into <img>/<video>; a private bucket returns 403 and every
# asset shows up broken. Make the bucket public at creation (or set a CDN public_url_base).
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=cineforge
B2_REGION=

# Generation provider for Backblaze hackathon
GMI_API_KEY=

# Optional. OPENAI_API_KEY is strongly recommended: the QC judge is a vision call and
# rubber-stamps every frame without it.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Which stack to route through: "gmicloud" (Backblaze) or "openai" (Build Week)
PROVIDER_STACK=gmicloud

# Auth (Supabase) — optional. Leave blank to run single-user with no login (the default;
# the whole app still works). Set any of these and every /api request must carry a valid
# Supabase JWT, and the library is scoped per user.
#   SUPABASE_URL           Project URL (Supabase → Project Settings → API).
#   SUPABASE_JWT_SECRET    Legacy HS256 "JWT secret" — fastest path, verified locally.
#   SUPABASE_ANON_KEY      anon public key; only needed if you rely on the remote-verify
#                          fallback (projects using asymmetric signing keys, no JWT secret).
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# Optional provider fallback — retried (in order) when the primary model errors mid-run.
# Defaults are set per stack in config.py; set empty to disable, or override with a
# comma-separated list. Fallbacks must accept the same params (duration/aspect_ratio).
# IMAGE_FALLBACK_MODELS=gemini-2.5-flash-image
# I2V_FALLBACK_MODELS=kling-image2video-v1.6-pro

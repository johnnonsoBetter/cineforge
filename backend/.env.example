# Copy to .env and fill in. Leave MOCK_MODE=true to run with no keys.
MOCK_MODE=true

# Backblaze B2 (storage) — required for real runs
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=cineforge
B2_REGION=

# Generation provider for Backblaze hackathon
GMI_API_KEY=

# Optional
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Which stack to route through: "gmicloud" (Backblaze) or "openai" (Build Week)
PROVIDER_STACK=gmicloud
